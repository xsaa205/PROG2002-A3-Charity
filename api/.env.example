# ---------------------------------------------------------------------------
# .env.example  -  copy this file to ".env" and fill in your own values.
# The real ".env" is git-ignored and must NEVER be committed.
#
# Local development (XAMPP/WAMP default):
#   DB_HOST=localhost
#   DB_USER=root
#   DB_PASSWORD=
#   DB_NAME=charityevents_a3
#
# SCU cPanel: create these values in "Setup Node.js App > Environment
# variables". The DB_USER is usually like "yourcpaneluser_zzcharity" and the
# DB_NAME like "yourcpaneluser_charityevents_a3".
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=charityevents_a3

# Port the Express API listens on (cPanel usually assigns its own PORT).
PORT=3000
